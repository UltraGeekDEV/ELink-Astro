[Unit]
Description=ELink station: the home rig (profile Home: OnStep mount + GPhoto camera), web on 8080
After=network-online.target
Wants=network-online.target
[Service]
User=ultrageek
SupplementaryGroups=dialout plugdev
WorkingDirectory=/home/ultrageek/elink/home
Environment=HOME=/home/ultrageek
Environment=ELINK_SOLVE_FIELD=/home/ultrageek/elink/bin/solve-field
ExecStart=/usr/bin/dotnet /home/ultrageek/elink/home/station/elink.dll --no-ui --listen 0.0.0.0 --port 5698 --web-listen 0.0.0.0 --web-port 8080 --ws-port 8081 --profile Home --compose /home/ultrageek/elink/home/state/compose.json --save-dir /home/ultrageek/elink/home/images --sky-data /nonexistent
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
SuccessExitStatus=130 143
MemoryAccounting=yes
CPUAccounting=yes
MemoryHigh=1000M
MemoryMax=1150M
[Install]
WantedBy=multi-user.target
