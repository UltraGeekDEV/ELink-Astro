[Unit]
Description=ELink test station (M31 scenario), headless, web on 8090
After=network-online.target m31-indi.service
Wants=network-online.target m31-indi.service
[Service]
User=ultrageek
WorkingDirectory=/home/ultrageek/elink/m31-test
Environment=HOME=/home/ultrageek
Environment=ELINK_SOLVE_FIELD=/home/ultrageek/elink/bin/solve-field
ExecStart=/usr/bin/dotnet /home/ultrageek/elink/m31-test/pi-station/elink.dll --no-ui --listen 0.0.0.0 --port 5699 --web-listen 0.0.0.0 --web-port 8090 --ws-port 8091 --indi 127.0.0.1:7625=sim --compose /home/ultrageek/elink/m31-test/state/compose.json --save-dir /home/ultrageek/elink/m31-test/images --sky-data /nonexistent
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
SuccessExitStatus=130 143
MemoryAccounting=yes
CPUAccounting=yes
MemoryHigh=1000M
MemoryMax=1150M
[Install]
WantedBy=multi-user.target
