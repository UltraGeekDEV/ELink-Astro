<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ELink.UI.Views.StorageView">
  <StackPanel Spacing="0">
    <Border Classes="card">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Classes="hint" Text="Saves every frame of the cameras and scopes you pick: one folder per night, FITS headers filled in, plus a session log."/>
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
          <TextBlock Classes="value" Text="{Binding FramesSaved}" HorizontalAlignment="Right"/>
          <TextBlock Classes="label" Text="frames saved" HorizontalAlignment="Right"/>
        </StackPanel>
      </Grid>
    </Border>
    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="section" Text="DIRECTORY"/>
        <WrapPanel Classes="row">
          <TextBox Text="{Binding DirectoryInput}" Width="520"/>
          <Button Content="Use" Classes="primary" Command="{Binding SetDirectoryCommand}"/>
        </WrapPanel>
        <TextBlock Classes="label" Text="{Binding Directory}"/>
        <TextBlock Classes="section" Text="FRAMES ARE BEING SAVED FOR" Margin="0,8,0,0"/>
        <WrapPanel Classes="row">
          <ComboBox ItemsSource="{Binding Shooters}" SelectedItem="{Binding SelectedShooter}" Width="220" PlaceholderText="Choose a camera or scope"/>
          <Button Content="Save its frames" Command="{Binding WatchCommand}"/>
        </WrapPanel>
        <ItemsControl ItemsSource="{Binding Watching}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <WrapPanel Classes="row"><TextBlock Text="{Binding}" VerticalAlignment="Center" Width="220"/>
                <Button Content="Stop" Padding="10,2" Command="{Binding $parent[UserControl].DataContext.UnwatchCommand}" CommandParameter="{Binding}"/></WrapPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Classes="error" Text="{Binding Message}" IsVisible="{Binding Message.Length}"/>
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Spacing="4">
        <TextBlock Classes="section" Text="RECENT"/>
        <TextBlock Classes="label" Text="{Binding LastFile}" TextWrapping="Wrap"/>
        <ItemsControl ItemsSource="{Binding Recent}">
          <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Classes="label"/></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
