<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ELink.UI.Controls"
             x:Class="ELink.UI.Views.WeatherPanelView">
  <StackPanel Spacing="0" IsEnabled="{Binding Connected}">
        <Border Classes="card">
      <StackPanel Spacing="8">
        <WrapPanel Classes="row">
          <StackPanel><TextBlock Classes="label" Text="SAFE TO OBSERVE"/><TextBlock Classes="value" Text="{Binding Safety}"/></StackPanel>
          <Button Content="Refresh" Command="{Binding RefreshCommand}" VerticalAlignment="Bottom" Margin="24,0,0,0"/>
        </WrapPanel>
        <ItemsControl ItemsSource="{Binding Parameters}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="260,120,*" Margin="0,2">
                <TextBlock Text="{Binding Label}" Opacity="0.75"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="Cascadia Mono,Consolas,DejaVu Sans Mono,monospace"/>
                <Border Grid.Column="2" Classes="pill" HorizontalAlignment="Left"><TextBlock Classes="label" Text="{Binding Status}"/></Border>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <c:Notice Text="{Binding Message}"/>
  </StackPanel>
</UserControl>
