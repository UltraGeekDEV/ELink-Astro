<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="using:ELink.UI.Infrastructure"
             x:Class="ELink.UI.Views.ScopesView">
  <Grid ColumnDefinitions="300,*">
    <!-- the scopes, each with what it is doing -->
    <Border Classes="panel" Padding="12">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="YOUR SCOPES"/>
          <StackPanel IsVisible="{Binding HasNoScopes}" Spacing="8">
            <TextBlock Classes="hint" Text="No scope yet."/>
            <Button Content="Set up a scope" Classes="primary" Command="{Binding GoToRigCommand}"/>
          </StackPanel>
          <ListBox ItemsSource="{Binding Cards}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="4" Margin="2,4">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Classes="row" Spacing="8"><Ellipse Classes="dot" Classes.pulse="{Binding Observing}" Fill="{Binding Accent, Converter={x:Static i:Chips.Hex}}"/><TextBlock Text="{Binding DisplayName}" Classes="h2" TextTrimming="CharacterEllipsis"/></StackPanel>
                    <Border Grid.Column="1" Classes="chip" Background="{Binding ChipClass, Converter={x:Static i:Chips.Background}}"><TextBlock Text="{Binding ChipText}"/></Border>
                  </Grid>
                  <TextBlock Classes="hint" Text="{Binding PointerLine}"/>
                  <TextBlock Classes="info" FontSize="12" Text="{Binding ScopeMessage}" IsVisible="{Binding ScopeMessage.Length}" TextTrimming="CharacterEllipsis"/>
                  <ProgressBar Minimum="0" Maximum="1" Value="{Binding ProgressFraction}" IsVisible="{Binding Observing}" Height="4"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="960" HorizontalAlignment="Stretch" Margin="16" Spacing="0">
        <Border Classes="card" IsVisible="{Binding HasNoScopes}">
          <StackPanel Spacing="8">
            <TextBlock Classes="h2" Text="Nothing here yet"/>
            <TextBlock Classes="hint" Text="Once you have set up a scope, this is where you watch it work: what it is doing now, the latest frame, how well it guides, and the sensor cooling. You ask it for images from the Sky view; it does the rest."/>
            <Button Content="Set up a scope" Classes="primary" Command="{Binding GoToRigCommand}" HorizontalAlignment="Left"/>
          </StackPanel>
        </Border>
        <ContentControl Content="{Binding Selected}"/>
        <Border Classes="card">
          <StackPanel Spacing="4">
            <TextBlock Classes="section" Text="TOOLS FOR DOING THINGS BY HAND"/>
            <TextBlock Classes="hint" Text="A scope focuses and centres itself when you set that up (Rig › Set up). These are for working without that, or for trying things out."/>
            <Expander Header="Focus helper: watch the focus while you turn the knob">
              <ContentControl Content="{Binding FocusAssist}" Margin="0,10,0,0"/>
            </Expander>
            <Expander Header="Autofocus now" IsVisible="{Binding HasScopes}">
              <ContentControl Content="{Binding Autofocus}" Margin="0,10,0,0"/>
            </Expander>
            <Expander Header="Re-centre after slews made outside ELink (hand controller, other software)" IsVisible="{Binding HasScopes}">
              <ContentControl Content="{Binding Centering}" Margin="0,10,0,0"/>
            </Expander>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
