<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ELink.UI.Controls"
             x:Class="ELink.UI.Views.SiteView">
  <StackPanel Spacing="0">
    <Border Classes="card">
      <StackPanel>
        <TextBlock Classes="hint" Text="Optional, but it lets ELink plan around the night: twilight, the Moon, when a target is above your horizon, and meridian flips. Type your latitude and longitude, or choose a GPS and leave them empty."/>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="section" Text="LOCATION"/>
        <WrapPanel Classes="row">
          <StackPanel><TextBlock Classes="label" Text="Name"/><TextBox Text="{Binding Label}" Width="130"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Latitude ° (north +)"/><TextBox Text="{Binding Latitude}" Width="150" Watermark="47:29:52 or 47.5"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Longitude ° (east +)"/><TextBox Text="{Binding Longitude}" Width="150" Watermark="19:02:25 or 19.04"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Elevation m"/><NumericUpDown Value="{Binding Elevation}" Minimum="-500" Maximum="9000" FormatString="0" Width="120"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="GPS"/><ComboBox ItemsSource="{Binding GpsDevices}" SelectedItem="{Binding Gps}" Width="190"/></StackPanel>
        </WrapPanel>
        <TextBlock Classes="section" Text="HORIZON" Margin="0,6,0,0"/>
        <TextBlock Classes="hint" Text="Nothing below the lowest altitude is imaged. Obstructions are what stands above it (a house, trees): give a few points round the compass, for example 180:15, 200:35, 260:35, 280:15 is a wall to the south-west. The picture under Tonight shows the result."/>
        <WrapPanel Classes="row">
          <StackPanel><TextBlock Classes="label" Text="Lowest altitude °"/><NumericUpDown Value="{Binding MinAltitude}" Minimum="-5" Maximum="80" FormatString="0.#" Width="130"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Obstructions: azimuth:altitude points (north is 0, east 90, south 180, west 270)"/><TextBox Text="{Binding HorizonText}" Width="520" Watermark="180:10, 200:35, 260:35, 280:10"/></StackPanel>
        </WrapPanel>
        <WrapPanel Classes="row">
          <CheckBox IsChecked="{Binding PushToMounts}" Content="Also send the location and time to the mounts"/>
          <Button Content="Apply" Classes="primary" Command="{Binding ApplyCommand}"/>
        </WrapPanel>
        <c:Notice Text="{Binding Message}" Kind="{Binding MessageKind}"/>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="6">
        <TextBlock Classes="section" Text="TONIGHT"/>
        <TextBlock Text="{Binding Where}"/>
        <c:NightBar Timeline="{Binding Night}" IsVisible="{Binding Known}" Margin="0,4"/>
        <TextBlock Classes="section" Text="YOUR SKY" Margin="0,8,0,0" IsVisible="{Binding Known}"/>
        <c:HorizonPlot Data="{Binding Atlas.Flat}" IsVisible="{Binding Known}" Height="190"/>
        <TextBlock Classes="hint" Text="Your horizon as saved (what blocks the sky), the Sun, Moon and planets, and the paths the chosen target and the image take." IsVisible="{Binding Known}"/>
        <TextBlock Text="{Binding SkyText}"/>
        <TextBlock Text="{Binding NightText}"/>
        <TextBlock Text="{Binding MoonText}"/>
        <TextBlock Classes="label" Text="{Binding StateMessage}" IsVisible="{Binding StateMessage.Length}" TextWrapping="Wrap"/>
        <ItemsControl ItemsSource="{Binding Bodies}" Margin="0,6,0,0">
          <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="monospace" Classes="label"/></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
