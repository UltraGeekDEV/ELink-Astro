<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ELink.UI.Views.FocuserPanelView">
  <StackPanel MaxWidth="760" Spacing="0">
    <Border Classes="card">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Classes="title" Text="{Binding DisplayName}"/>
          <TextBlock Classes="label" Text="{Binding Id}"/>
        </StackPanel>
        <Button Grid.Column="1" Content="{Binding ConnectButtonText}" Command="{Binding ConnectCommand}" VerticalAlignment="Center"/>
      </Grid>
    </Border>
    <Border Classes="card">
      <Grid ColumnDefinitions="*,*,*">
        <StackPanel><TextBlock Classes="label" Text="POSITION"/><TextBlock Classes="value" Text="{Binding Position}"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Classes="label" Text="MAX"/><TextBlock Classes="value" Text="{Binding MaxPosition}"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Classes="label" Text="MOVING / TEMP"/><TextBlock FontSize="16"><Run Text="{Binding Moving}"/> · <Run Text="{Binding TemperatureText}"/></TextBlock></StackPanel>
      </Grid>
    </Border>
    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="section" Text="MOVE"/>
        <StackPanel Classes="row">
          <StackPanel><TextBlock Classes="label" Text="Go to position"/><NumericUpDown Value="{Binding TargetPosition}" Minimum="0" FormatString="0" Width="160"/></StackPanel>
          <Button Content="Move" Classes="primary" Command="{Binding MoveToCommand}" VerticalAlignment="Bottom"/>
        </StackPanel>
        <StackPanel Classes="row">
          <StackPanel><TextBlock Classes="label" Text="Step"/><NumericUpDown Value="{Binding StepSize}" Minimum="1" FormatString="0" Width="160"/></StackPanel>
          <Button Content="◀ In" Command="{Binding InCommand}" VerticalAlignment="Bottom"/>
          <Button Content="Out ▶" Command="{Binding OutCommand}" VerticalAlignment="Bottom"/>
          <Button Content="Abort" Classes="danger" Command="{Binding AbortCommand}" VerticalAlignment="Bottom"/>
        </StackPanel>
      </StackPanel>
    </Border>
    <TextBlock Classes="error" Text="{Binding Message}" IsVisible="{Binding Message.Length}"/>
  </StackPanel>
</UserControl>
