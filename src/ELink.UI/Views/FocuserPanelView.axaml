<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ELink.UI.Controls" xmlns:i="using:ELink.UI.Infrastructure"
             x:Class="ELink.UI.Views.FocuserPanelView">
  <StackPanel Spacing="0" IsEnabled="{Binding Connected}">
        <Border Classes="card">
      <Grid ColumnDefinitions="*,*,*,*">
        <StackPanel><TextBlock Classes="label" Text="POSITION"/><TextBlock Classes="value" Text="{Binding Position}"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Classes="label" Text="MAX TRAVEL"/><TextBlock Classes="value" Text="{Binding MaxPosition}"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Classes="label" Text="MOVING"/><TextBlock Classes="value" Text="{Binding Moving, Converter={x:Static i:Chips.YesNo}}"/></StackPanel>
        <StackPanel Grid.Column="3"><TextBlock Classes="label" Text="TEMPERATURE"/><TextBlock Classes="value" Text="{Binding TemperatureText}"/></StackPanel>
      </Grid>
    </Border>
    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="section" Text="MOVE"/>
        <WrapPanel Classes="row" IsVisible="{Binding CanMoveAbsolute}">
          <StackPanel><TextBlock Classes="label" Text="Go to position"/><NumericUpDown Value="{Binding TargetPosition}" Minimum="0" FormatString="0" Width="160"/></StackPanel>
          <Button Content="Move" Classes="primary" Command="{Binding MoveToCommand}" VerticalAlignment="Bottom"/>
        </WrapPanel>
        <WrapPanel Classes="row" IsVisible="{Binding CanMoveSteps}">
          <StackPanel><TextBlock Classes="label" Text="Steps"/><NumericUpDown Value="{Binding StepSize}" Minimum="1" FormatString="0" Width="160"/></StackPanel>
          <Button Content="◀ In" Command="{Binding InCommand}" VerticalAlignment="Bottom"/>
          <Button Content="Out ▶" Command="{Binding OutCommand}" VerticalAlignment="Bottom"/>
        </WrapPanel>
        <WrapPanel Classes="row" IsVisible="{Binding CanMoveTimed}">
          <StackPanel><TextBlock Classes="label" Text="Milliseconds"/><NumericUpDown Value="{Binding TimedMilliseconds}" Minimum="1" Maximum="60000" FormatString="0" Width="160"/></StackPanel>
          <Button Content="◀ In for" Command="{Binding TimedInCommand}" VerticalAlignment="Bottom"/>
          <Button Content="Out for ▶" Command="{Binding TimedOutCommand}" VerticalAlignment="Bottom"/>
        </WrapPanel>
        <Button Content="Abort" Classes="danger" Command="{Binding AbortCommand}" IsVisible="{Binding CanAbort}" HorizontalAlignment="Left"/>
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="section" Text="SETTINGS"/>
        <WrapPanel Classes="row" IsVisible="{Binding CanSync}">
          <StackPanel><TextBlock Classes="label" Text="Call the current position"/><NumericUpDown Value="{Binding SyncPosition}" Minimum="0" FormatString="0" Width="160"/></StackPanel>
          <Button Content="Sync" Command="{Binding SyncCommand}" VerticalAlignment="Bottom"/>
        </WrapPanel>
        <WrapPanel Classes="row" IsVisible="{Binding HasBacklash}">
          <CheckBox IsChecked="{Binding BacklashInput}" Content="Backlash compensation" VerticalAlignment="Bottom"/>
          <StackPanel><TextBlock Classes="label" Text="Steps"/><NumericUpDown Value="{Binding BacklashStepsInput}" Minimum="0" FormatString="0" Width="140"/></StackPanel>
          <Button Content="Apply" Command="{Binding BacklashCommand}" VerticalAlignment="Bottom"/>
          <TextBlock Classes="label" VerticalAlignment="Bottom"><Run Text="now "/><Run Text="{Binding BacklashSteps}"/><Run Text=" steps"/></TextBlock>
        </WrapPanel>
        <WrapPanel Classes="row">
          <StackPanel><TextBlock Classes="label" Text="Max travel"/><NumericUpDown Value="{Binding NewMaxPosition}" Minimum="1" FormatString="0" Width="160"/></StackPanel>
          <Button Content="Set" Command="{Binding MaxCommand}" VerticalAlignment="Bottom"/>
        </WrapPanel>
        <WrapPanel Classes="row" IsVisible="{Binding HasSpeed}">
          <StackPanel><TextBlock Classes="label" Text="Speed"/><NumericUpDown Value="{Binding SpeedInput}" Minimum="0" FormatString="0.##" Width="140"/></StackPanel>
          <Button Content="Set" Command="{Binding SpeedCommand}" VerticalAlignment="Bottom"/>
        </WrapPanel>
        <Button Content="{Binding ReverseButtonText}" Command="{Binding ReverseCommand}" IsVisible="{Binding CanReverse}" HorizontalAlignment="Left"/>
      </StackPanel>
    </Border>
    <c:Notice Text="{Binding Message}"/>
  </StackPanel>
</UserControl>
