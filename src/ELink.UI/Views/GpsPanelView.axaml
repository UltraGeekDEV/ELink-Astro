<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ELink.UI.Controls"
             x:Class="ELink.UI.Views.GpsPanelView">
  <StackPanel Spacing="0" IsEnabled="{Binding Connected}">
        <Border Classes="card">
      <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto">
        <StackPanel><TextBlock Classes="label" Text="LATITUDE"/><TextBlock Classes="value" Text="{Binding LatitudeText}"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Classes="label" Text="LONGITUDE"/><TextBlock Classes="value" Text="{Binding LongitudeText}"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Classes="label" Text="ELEVATION"/><TextBlock Classes="value" Text="{Binding ElevationText}"/></StackPanel>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0"><TextBlock Classes="label" Text="TIME (UTC)"/><TextBlock Classes="value" Text="{Binding TimeUtc}"/></StackPanel>
        <Button Grid.Row="2" Content="Refresh fix" Command="{Binding RefreshCommand}" Margin="0,12,0,0" HorizontalAlignment="Left"/>
      </Grid>
    </Border>
    <c:Notice Text="{Binding Message}"/>
  </StackPanel>
</UserControl>
