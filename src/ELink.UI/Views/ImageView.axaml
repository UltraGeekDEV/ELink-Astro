<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ELink.UI.Views.ImageView">
  <StackPanel MaxWidth="1000" Spacing="0">
    <Border Classes="card">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Classes="title" Text="Image"/>
          <TextBlock Classes="label" TextWrapping="Wrap" Text="Say what image you want: where, how big, how deep. The scopes you tick share the work: each takes the next spot for its own frames whenever it is free, with a small dither, and guides, flips and focuses by itself. A single target is just an area of 0 × 0 (one frame)."/>
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
          <TextBlock Classes="value" Text="{Binding Phase}" HorizontalAlignment="Right"/>
          <TextBlock Classes="label" Text="{Binding Progress}" HorizontalAlignment="Right"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="section" Text="WHAT"/>
        <StackPanel Classes="row">
          <StackPanel><TextBlock Classes="label" Text="Name"/><TextBox Text="{Binding Label}" Width="130"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Centre RA (J2000)"/><TextBox Text="{Binding CenterRa}" Width="120"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Centre Dec (J2000)"/><TextBox Text="{Binding CenterDec}" Width="120"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Width ° (0 = one frame)"/><NumericUpDown Value="{Binding Width}" Minimum="0" Maximum="60" Increment="0.1" FormatString="0.###" Width="150"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Height °"/><NumericUpDown Value="{Binding Height}" Minimum="0" Maximum="60" Increment="0.1" FormatString="0.###" Width="120"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Angle °"/><NumericUpDown Value="{Binding PositionAngle}" Minimum="-180" Maximum="180" FormatString="0.#" Width="110"/></StackPanel>
        </StackPanel>
        <StackPanel Classes="row">
          <StackPanel><TextBlock Classes="label" Text="Seconds per shot"/><NumericUpDown Value="{Binding ExposureSeconds}" Minimum="0.01" FormatString="0.##" Width="130"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Filter (optional)"/><TextBox Text="{Binding Filter}" Width="110"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Minutes per spot (0 = until stopped)"/><NumericUpDown Value="{Binding TargetMinutes}" Minimum="0" Increment="10" FormatString="0.##" Width="210"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Output &quot;/px (0 = finest train)"/><NumericUpDown Value="{Binding OutputScale}" Minimum="0" Increment="0.5" FormatString="0.###" Width="170"/></StackPanel>
          <CheckBox IsChecked="{Binding LiveStack}" Content="Build the image live" VerticalAlignment="Bottom"/>
        </StackPanel>

        <TextBlock Classes="section" Text="WHO" Margin="0,6,0,0"/>
        <ItemsControl ItemsSource="{Binding Scopes}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected}" Content="{Binding Id}" Margin="0,0,16,0"/></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Classes="row">
          <StackPanel><TextBlock Classes="label" Text="Dither &quot; (every shot)"/><NumericUpDown Value="{Binding DitherArcsec}" Minimum="0" Increment="5" FormatString="0" Width="140"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Stepover ° (0 = auto)"/><NumericUpDown Value="{Binding Stepover}" Minimum="0" Increment="0.01" FormatString="0.###" Width="140"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Max shots (0 = none)"/><NumericUpDown Value="{Binding MaxVisits}" Minimum="0" FormatString="0" Width="130"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Weather guard"/><ComboBox ItemsSource="{Binding Weather}" SelectedItem="{Binding SelectedWeather}" Width="150"/></StackPanel>
        </StackPanel>
        <StackPanel Classes="row">
          <Button Content="Preview" Command="{Binding PreviewCommand}"/>
          <Button Content="Start" Classes="primary" Command="{Binding StartRunCommand}"/>
          <Button Content="Pause" Command="{Binding PauseCommand}"/>
          <Button Content="Resume" Command="{Binding ResumeCommand}"/>
          <Button Content="Abort" Classes="danger" Command="{Binding AbortCommand}"/>
          <Button Content="Apply depth now" Command="{Binding ApplyTargetCommand}"/>
        </StackPanel>
        <TextBlock Classes="label" Text="{Binding Summary}" TextWrapping="Wrap"/>
        <TextBlock Classes="error" Text="{Binding Message}" IsVisible="{Binding Message.Length}" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="6">
        <TextBlock Classes="section" Text="COVERAGE (yellow = deep enough; outlines: where each scope is shooting)"/>
        <TextBlock Classes="label" Text="{Binding CoverageText}"/>
        <Grid Width="{Binding BoxW}" Height="{Binding BoxHeight}" HorizontalAlignment="Left">
          <Image Source="{Binding Map}" Stretch="Fill" RenderOptions.BitmapInterpolationMode="None"/>
          <ItemsControl ItemsSource="{Binding Outlines}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate><Polygon Points="{Binding Points}" Stroke="#FFFFFF" StrokeThickness="1.5"/></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
        <ItemsControl ItemsSource="{Binding Workers}">
          <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}"/></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="6">
        <TextBlock Classes="section" Text="THE IMAGE"/>
        <TextBlock Classes="label" Text="{Binding Stack.Info}"/>
        <Image Source="{Binding Stack.Image}" Stretch="Uniform" MaxHeight="620"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
