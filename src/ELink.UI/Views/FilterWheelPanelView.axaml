<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ELink.UI.Controls"
             x:Class="ELink.UI.Views.FilterWheelPanelView">
  <StackPanel Spacing="0" IsEnabled="{Binding Connected}">
        <Border Classes="card">
      <StackPanel Spacing="10">
        <WrapPanel Classes="row">
          <StackPanel><TextBlock Classes="label" Text="SLOT"/><TextBlock Classes="value" Text="{Binding Slot}"/></StackPanel>
          <StackPanel Margin="24,0,0,0"><TextBlock Classes="label" Text="MOVING"/><TextBlock Classes="value" Text="{Binding Moving}"/></StackPanel>
        </WrapPanel>
        <TextBlock Classes="section" Text="FILTERS"/>
        <ItemsControl ItemsSource="{Binding Filters}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Content="{Binding}" Margin="0,0,8,8" MinWidth="90"
                      Command="{Binding $parent[UserControl].DataContext.SelectCommand}" CommandParameter="{Binding}"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <c:Notice Text="{Binding Message}"/>
  </StackPanel>
</UserControl>
