<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ELink.UI.Controls" xmlns:i="using:ELink.UI.Infrastructure"
             x:Class="ELink.UI.Views.ScopePanelView">
  <StackPanel Spacing="0">
    <!-- what it is doing, in one place -->
    <Border Classes="card">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Classes="title" Text="{Binding DisplayName}"/>
            <TextBlock Classes="hint" Text="{Binding ScopeId}"/>
          </StackPanel>
          <Border Grid.Column="1" Classes="chip" Background="{Binding ChipClass, Converter={x:Static i:Chips.Background}}" VerticalAlignment="Top">
            <TextBlock Text="{Binding ChipText}"/>
          </Border>
        </Grid>
        <ProgressBar Minimum="0" Maximum="1" Value="{Binding ProgressFraction}" IsVisible="{Binding Observing}" Height="6"/>
        <TextBlock Text="{Binding ScopeMessage}" IsVisible="{Binding ScopeMessage.Length}" Classes="info"/>
        <StackPanel Classes="row" Spacing="28">
          <StackPanel><TextBlock Classes="label" Text="RA"/><TextBlock Classes="value" Text="{Binding RaText}"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Dec"/><TextBlock Classes="value" Text="{Binding DecText}"/></StackPanel>
          <StackPanel VerticalAlignment="Bottom"><TextBlock Classes="label" Text="Mount"/><TextBlock Text="{Binding PointerLine}"/></StackPanel>
          <StackPanel VerticalAlignment="Bottom" IsVisible="{Binding FilterText.Length}"><TextBlock Classes="label" Text="Filter"/><TextBlock Text="{Binding FilterText}"/></StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="6">
        <TextBlock Classes="section" Text="LATEST FRAME"/>
        <TextBlock Text="{Binding Preview.Info}" Classes="label"/>
        <Image Source="{Binding Preview.Image}" Stretch="Uniform" MaxHeight="440" HorizontalAlignment="Left"/>
        <ItemsControl ItemsSource="{Binding Shots}">
          <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Classes="hint"/></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding HasGuider}">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="section" Text="GUIDING"/>
          <TextBlock Grid.Column="1" Classes="h2" Text="{Binding GuidePhase}"/>
        </Grid>
        <TextBlock Text="{Binding GuideText}" TextWrapping="Wrap"/>
        <TextBlock Classes="hint" Text="{Binding GuideCalibration}"/>
        <Border Background="#0B1220" CornerRadius="6" Width="600" Height="120" HorizontalAlignment="Left" ClipToBounds="True">
          <Canvas Width="600" Height="120">
            <Line StartPoint="0,60" EndPoint="600,60" Stroke="#33557A" StrokeThickness="1"/>
            <Polyline Points="{Binding RaGraph}" Stroke="#5AA9FF" StrokeThickness="1.6"/>
            <Polyline Points="{Binding DecGraph}" Stroke="#FF6B6B" StrokeThickness="1.6"/>
          </Canvas>
        </Border>
        <TextBlock Classes="hint" Text="RA (blue) and Dec (red) error, ±4&quot; full height, last 100 guide frames. The scope guides, settles and dithers by itself; these are for testing."/>
        <StackPanel Classes="row">
          <Button Content="Start guiding" Command="{Binding StartGuidingCommand}"/>
          <Button Content="Stop" Command="{Binding StopGuidingCommand}"/>
          <Button Content="Recalibrate" Command="{Binding RecalibrateCommand}"/>
          <Button Content="Dither now" Command="{Binding DitherNowCommand}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding HasCoolers}">
      <StackPanel Spacing="6">
        <TextBlock Classes="section" Text="COOLING"/>
        <TextBlock Text="{Binding CoolerText}" TextWrapping="Wrap"/>
        <TextBlock Classes="hint" Text="The train ramps the sensor slowly, and the scope waits until it is cold before it exposes."/>
        <StackPanel Classes="row">
          <Button Content="Cool" Command="{Binding CoolCommand}"/>
          <Button Content="Warm up" Command="{Binding WarmCommand}" ToolTip.Tip="Ramp up slowly, then switch the coolers off (end of the night)"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <Expander Header="Manual control: point and take frames">
        <StackPanel Spacing="10" Margin="0,10,0,0">
          <StackPanel Classes="row">
            <StackPanel><TextBlock Classes="label" Text="RA (h:m:s)"/><TextBox Text="{Binding TargetRa}" Width="130"/></StackPanel>
            <StackPanel><TextBlock Classes="label" Text="Dec (°:′:″)"/><TextBox Text="{Binding TargetDec}" Width="130"/></StackPanel>
            <StackPanel><TextBlock Classes="label" Text="Epoch"/><ComboBox ItemsSource="{Binding Epochs}" SelectedItem="{Binding TargetEpoch}" Width="100"/></StackPanel>
          </StackPanel>
          <StackPanel Classes="row">
            <StackPanel><TextBlock Classes="label" Text="Seconds"/><NumericUpDown Value="{Binding ExposureSeconds}" Minimum="0" Maximum="3600" FormatString="0.###" Increment="0.5" Width="110"/></StackPanel>
            <StackPanel><TextBlock Classes="label" Text="Frames"/><NumericUpDown Value="{Binding Count}" Minimum="1" Maximum="100000" FormatString="0" Width="100"/></StackPanel>
            <StackPanel><TextBlock Classes="label" Text="Filter (optional)"/><TextBox Text="{Binding Filter}" Width="120" Watermark="e.g. Red"/></StackPanel>
            <StackPanel><TextBlock Classes="label" Text="Frame type"/><ComboBox ItemsSource="{Binding FrameTypes}" SelectedItem="{Binding FrameType}" Width="100"/></StackPanel>
          </StackPanel>
          <StackPanel Classes="row">
            <Button Content="Go there and take frames" Classes="primary" Command="{Binding ObserveCommand}"/>
            <Button Content="Go there only" Command="{Binding GotoCommand}"/>
            <Button Content="Take a frame here" Command="{Binding ExposeCommand}"/>
            <Button Content="Abort" Classes="danger" Command="{Binding AbortCommand}"/>
          </StackPanel>
          <c:Notice Text="{Binding Message}"/>
        </StackPanel>
      </Expander>
    </Border>
  </StackPanel>
</UserControl>
