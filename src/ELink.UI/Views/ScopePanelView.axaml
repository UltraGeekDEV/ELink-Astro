<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ELink.UI.Views.ScopePanelView">
  <StackPanel MaxWidth="940" Spacing="0">
    <Border Classes="card">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Classes="title" Text="{Binding DisplayName}"/>
          <TextBlock Classes="label" Text="{Binding ScopeId}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
          <TextBlock Classes="value" Text="{Binding ScopePhase}" HorizontalAlignment="Right"/>
          <TextBlock Classes="label" Text="{Binding Progress}" HorizontalAlignment="Right"/>
        </StackPanel>
      </Grid>
    </Border>
    <Border Classes="card">
      <Grid ColumnDefinitions="*,*">
        <StackPanel>
          <TextBlock Classes="section" Text="POINTING"/>
          <StackPanel Classes="row">
            <StackPanel><TextBlock Classes="label" Text="RA"/><TextBlock Classes="value" Text="{Binding RaText}"/></StackPanel>
            <StackPanel Margin="16,0,0,0"><TextBlock Classes="label" Text="DEC"/><TextBlock Classes="value" Text="{Binding DecText}"/></StackPanel>
          </StackPanel>
          <TextBlock Classes="label" Margin="0,4,0,0"><Run Text="{Binding PointerPhase}"/> · on target: <Run Text="{Binding OnTarget}"/></TextBlock>
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Classes="section" Text="SHOOTING"/>
          <TextBlock Classes="value" Text="{Binding ShooterPhase}"/>
          <TextBlock Classes="label" Margin="0,4,0,0"><Run Text="filter: "/><Run Text="{Binding FilterText}"/><Run Text="  ·  frames per round: "/><Run Text="{Binding ShotsPerRound}"/></TextBlock>
        </StackPanel>
      </Grid>
    </Border>
    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="section" Text="POINT AND SHOOT"/>
        <StackPanel Classes="row">
          <StackPanel><TextBlock Classes="label" Text="RA (h:m:s)"/><TextBox Text="{Binding TargetRa}" Width="130"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="DEC (°:′:″)"/><TextBox Text="{Binding TargetDec}" Width="130"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Epoch"/><ComboBox ItemsSource="{Binding Epochs}" SelectedItem="{Binding TargetEpoch}" Width="100"/></StackPanel>
        </StackPanel>
        <StackPanel Classes="row">
          <StackPanel><TextBlock Classes="label" Text="Seconds"/><NumericUpDown Value="{Binding ExposureSeconds}" Minimum="0" Maximum="3600" FormatString="0.###" Increment="0.5" Width="130"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Count"/><NumericUpDown Value="{Binding Count}" Minimum="1" Maximum="100000" FormatString="0" Width="110"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Filter (optional)"/><TextBox Text="{Binding Filter}" Width="120" Watermark="e.g. Red"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Frame"/><ComboBox ItemsSource="{Binding FrameTypes}" SelectedItem="{Binding FrameType}" Width="100"/></StackPanel>
        </StackPanel>
        <StackPanel Classes="row">
          <Button Content="Observe" Classes="primary" Command="{Binding ObserveCommand}"/>
          <Button Content="Go to only" Command="{Binding GotoCommand}"/>
          <Button Content="Expose only" Command="{Binding ExposeCommand}"/>
          <Button Content="Abort" Classes="danger" Command="{Binding AbortCommand}"/>
        </StackPanel>
        <TextBlock Classes="error" Text="{Binding ScopeMessage}" IsVisible="{Binding ScopeMessage.Length}"/>
        <TextBlock Classes="error" Text="{Binding Message}" IsVisible="{Binding Message.Length}"/>
      </StackPanel>
    </Border>
    <Border Classes="card" IsVisible="{Binding HasGuider}">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="section" Text="GUIDING (THE SCOPE DOES THIS BY ITSELF)"/>
          <TextBlock Grid.Column="1" Classes="value" Text="{Binding GuidePhase}"/>
        </Grid>
        <TextBlock Text="{Binding GuideText}" TextWrapping="Wrap"/>
        <TextBlock Classes="label" Text="{Binding GuideCalibration}"/>
        <Border Background="#0B1220" CornerRadius="4" Width="600" Height="120" HorizontalAlignment="Left" ClipToBounds="True">
          <Canvas Width="600" Height="120">
            <Line StartPoint="0,60" EndPoint="600,60" Stroke="#33557A" StrokeThickness="1"/>
            <Polyline Points="{Binding RaGraph}" Stroke="#5AA9FF" StrokeThickness="1.6"/>
            <Polyline Points="{Binding DecGraph}" Stroke="#FF6B6B" StrokeThickness="1.6"/>
          </Canvas>
        </Border>
        <TextBlock Classes="label" Text="RA (blue) and Dec (red) error, ±4&quot; full height, last 100 guide frames"/>
        <StackPanel Classes="row">
          <Button Content="Start guiding" Command="{Binding StartGuidingCommand}"/>
          <Button Content="Stop" Command="{Binding StopGuidingCommand}"/>
          <Button Content="Recalibrate" Command="{Binding RecalibrateCommand}"/>
          <Button Content="Dither now" Command="{Binding DitherNowCommand}"/>
        </StackPanel>
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Spacing="6">
        <TextBlock Classes="section" Text="LATEST FRAME"/>
        <TextBlock Text="{Binding Preview.Info}" Classes="label"/>
        <Image Source="{Binding Preview.Image}" Stretch="Uniform" MaxHeight="520"/>
        <ItemsControl ItemsSource="{Binding Shots}">
          <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Classes="label"/></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
