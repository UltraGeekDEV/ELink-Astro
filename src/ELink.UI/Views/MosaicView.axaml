<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ELink.UI.Views.MosaicView">
  <StackPanel MaxWidth="1000" Spacing="0">
    <Border Classes="card">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Classes="title" Text="Mosaic"/>
          <TextBlock Classes="label" TextWrapping="Wrap" Text="Slowly paints a virtual field of view with exposure time: many single shots in small stepovers, always toward the least-covered part, until every spot has the target. Frames can differ in size, angle and offset; a rotator can turn the whole scope between passes."/>
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
          <TextBlock Classes="value" Text="{Binding Phase}" HorizontalAlignment="Right"/>
          <TextBlock Classes="label" Text="{Binding Progress}" HorizontalAlignment="Right"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="section" Text="AREA TO PAINT"/>
        <StackPanel Classes="row">
          <StackPanel><TextBlock Classes="label" Text="Name"/><TextBox Text="{Binding Label}" Width="130"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Centre RA (J2000)"/><TextBox Text="{Binding CenterRa}" Width="120"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Centre Dec (J2000)"/><TextBox Text="{Binding CenterDec}" Width="120"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Width °"/><NumericUpDown Value="{Binding FovWidth}" Minimum="0.01" Maximum="60" Increment="0.1" FormatString="0.###" Width="120"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Height °"/><NumericUpDown Value="{Binding FovHeight}" Minimum="0.01" Maximum="60" Increment="0.1" FormatString="0.###" Width="120"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Angle °"/><NumericUpDown Value="{Binding PositionAngle}" Minimum="-180" Maximum="180" FormatString="0.#" Width="110"/></StackPanel>
        </StackPanel>

        <TextBlock Classes="section" Text="FRAMES THE SCOPE TAKES ON EVERY SHOT" Margin="0,6,0,0"/>
        <ItemsControl ItemsSource="{Binding Frames}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Classes="row" Margin="0,0,0,4">
                <StackPanel><TextBlock Classes="label" Text="Label"/><TextBox Text="{Binding Label}" Width="110"/></StackPanel>
                <StackPanel><TextBlock Classes="label" Text="Width °"/><NumericUpDown Value="{Binding Width}" Minimum="0.001" Increment="0.05" FormatString="0.####" Width="115"/></StackPanel>
                <StackPanel><TextBlock Classes="label" Text="Height °"/><NumericUpDown Value="{Binding Height}" Minimum="0.001" Increment="0.05" FormatString="0.####" Width="115"/></StackPanel>
                <StackPanel><TextBlock Classes="label" Text="Rotation °"/><NumericUpDown Value="{Binding Rotation}" Minimum="-180" Maximum="180" FormatString="0.#" Width="105"/></StackPanel>
                <StackPanel><TextBlock Classes="label" Text="Offset east °"/><NumericUpDown Value="{Binding OffsetEast}" Increment="0.05" FormatString="0.###" Width="115"/></StackPanel>
                <StackPanel><TextBlock Classes="label" Text="Offset north °"/><NumericUpDown Value="{Binding OffsetNorth}" Increment="0.05" FormatString="0.###" Width="115"/></StackPanel>
                <Button Content="Remove" Command="{Binding $parent[UserControl].DataContext.RemoveFrameCommand}" CommandParameter="{Binding}" VerticalAlignment="Bottom"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Classes="row">
          <Button Content="+ Add frame" Command="{Binding AddFrameCommand}"/>
          <StackPanel><TextBlock Classes="label" Text="Camera"/><ComboBox ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}" Width="170"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Focal length mm"/><NumericUpDown Value="{Binding FocalLength}" Minimum="1" FormatString="0.#" Width="130"/></StackPanel>
          <Button Content="Frame 1 from camera" Command="{Binding ComputeFrameCommand}" VerticalAlignment="Bottom"/>
        </StackPanel>

        <TextBlock Classes="section" Text="PAINTING" Margin="0,6,0,0"/>
        <StackPanel Classes="row">
          <StackPanel><TextBlock Classes="label" Text="Smart scope"/><ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding SelectedScope}" Width="160"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Seconds per shot"/><NumericUpDown Value="{Binding ExposureSeconds}" Minimum="0.1" FormatString="0.##" Width="125"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Target minutes per spot"/><NumericUpDown Value="{Binding TargetMinutes}" Minimum="0" Increment="5" FormatString="0.##" Width="150"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Stepover °"/><NumericUpDown Value="{Binding Stepover}" Minimum="0" Increment="0.01" FormatString="0.###" Width="115"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Max shots (0 = none)"/><NumericUpDown Value="{Binding MaxVisits}" Minimum="0" FormatString="0" Width="130"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Weather guard"/><ComboBox ItemsSource="{Binding Weather}" SelectedItem="{Binding SelectedWeather}" Width="150"/></StackPanel>
        </StackPanel>
        <StackPanel Classes="row">
          <StackPanel><TextBlock Classes="label" Text="Rotator (optional)"/><ComboBox ItemsSource="{Binding Rotators}" SelectedItem="{Binding SelectedRotator}" Width="190"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Field angles to cycle, e.g. 0, 60, 120"/><TextBox Text="{Binding RotationsText}" Width="220"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Rotator zero offset °"/><NumericUpDown Value="{Binding RotatorOffset}" FormatString="0.##" Width="135"/></StackPanel>
        </StackPanel>
        <StackPanel Classes="row">
          <Button Content="Preview" Command="{Binding PreviewCommand}"/>
          <Button Content="Start" Classes="primary" Command="{Binding StartRunCommand}"/>
          <Button Content="Pause" Command="{Binding PauseCommand}"/>
          <Button Content="Resume" Command="{Binding ResumeCommand}"/>
          <Button Content="Abort" Classes="danger" Command="{Binding AbortCommand}"/>
          <Button Content="Apply target now" Command="{Binding ApplyTargetCommand}"/>
          <Button Content="Apply stepover now" Command="{Binding ApplyStepoverCommand}"/>
        </StackPanel>
        <TextBlock Text="{Binding Summary}" Classes="label"/>
        <TextBlock Classes="error" Text="{Binding Message}" IsVisible="{Binding Message.Length}"/>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="6">
        <TextBlock Classes="section" Text="COVERAGE: exposure time received by every spot (yellow = target reached); outlines show where the scope is shooting"/>
        <TextBlock Classes="label" Text="{Binding CoverageText}"/>
        <Border Background="#171B23" CornerRadius="6" Width="600" Height="{Binding BoxHeight}" HorizontalAlignment="Left" ClipToBounds="True">
          <Grid>
            <Image Source="{Binding Map}" Stretch="Fill" Width="600" Height="{Binding BoxHeight}"/>
            <ItemsControl ItemsSource="{Binding Outlines}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate><Polygon Points="{Binding Points}" Stroke="#FFD54F" StrokeThickness="2"/></DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
        </Border>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
