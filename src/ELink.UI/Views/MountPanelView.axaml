<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ELink.UI.Controls"
             x:Class="ELink.UI.Views.MountPanelView">
  <StackPanel Spacing="0" IsEnabled="{Binding Connected}">
        <Border Classes="card">
      <StackPanel>
        <TextBlock Classes="section" Text="POSITION"/>
        <WrapPanel>
          <StackPanel Margin="0,0,24,6"><TextBlock Classes="label" Text="RA"/><TextBlock Classes="value" Text="{Binding RaText}"/></StackPanel>
          <StackPanel Margin="0,0,24,6"><TextBlock Classes="label" Text="DEC"/><TextBlock Classes="value" Text="{Binding DecText}"/></StackPanel>
          <StackPanel Margin="0,0,24,6"><TextBlock Classes="label" Text="STATE"/><TextBlock Classes="value" Text="{Binding Phase}"/></StackPanel>
          <StackPanel Margin="0,0,24,6"><TextBlock Classes="label" Text="PIER SIDE · EPOCH"/><TextBlock FontSize="16"><Run Text="{Binding PierSide}"/> · <Run Text="{Binding Epoch}"/></TextBlock></StackPanel>
        </WrapPanel>
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="section" Text="GO TO"/>
        <WrapPanel Classes="row">
          <StackPanel><TextBlock Classes="label" Text="RA (h:m:s)"/><TextBox Text="{Binding TargetRa}" Width="140"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="DEC (°:′:″)"/><TextBox Text="{Binding TargetDec}" Width="140"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Epoch"/><ComboBox ItemsSource="{Binding Epochs}" SelectedItem="{Binding TargetEpoch}" Width="100"/></StackPanel>
        </WrapPanel>
        <WrapPanel Classes="row">
          <Button Content="Go to" Classes="primary" Command="{Binding GotoCommand}"/>
          <Button Content="Sync" Command="{Binding SyncCommand}"/>
          <Button Content="Abort" Classes="danger" Command="{Binding AbortCommand}"/>
          <Button Content="{Binding TrackButtonText}" Command="{Binding TrackCommand}"/>
          <Button Content="{Binding ParkButtonText}" Command="{Binding ParkCommand}"/>
        </WrapPanel>
      </StackPanel>
    </Border>
    <c:Notice Text="{Binding Message}"/>
  </StackPanel>
</UserControl>
