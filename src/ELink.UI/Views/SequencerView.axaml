<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ELink.UI.Views.SequencerView">
  <StackPanel MaxWidth="980" Spacing="0">
    <Border Classes="card">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Classes="title" Text="Sequence"/>
          <TextBlock Classes="label" Text="{Binding BlockText}"/>
          <TextBlock Classes="label" Text="{Binding Progress}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
          <TextBlock Classes="value" Text="{Binding Phase}" HorizontalAlignment="Right"/>
          <TextBlock Classes="label" Text="{Binding StateMessage}" HorizontalAlignment="Right"/>
        </StackPanel>
      </Grid>
    </Border>
    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="section" Text="PLAN"/>
        <StackPanel Classes="row">
          <StackPanel><TextBlock Classes="label" Text="Plan id"/><TextBox Text="{Binding PlanId}" Width="130"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Smart scope"/><ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding SelectedScope}" Width="180"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Weather guard"/><ComboBox ItemsSource="{Binding Weather}" SelectedItem="{Binding SelectedWeather}" Width="200"/></StackPanel>
        </StackPanel>
        <StackPanel Classes="row">
          <StackPanel><TextBlock Classes="label" Text="Autofocus shooter"/><ComboBox ItemsSource="{Binding Shooters}" SelectedItem="{Binding FocusShooter}" Width="180"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Autofocus focuser (for refocus blocks)"/><ComboBox ItemsSource="{Binding Focusers}" SelectedItem="{Binding FocusFocuser}" Width="260"/></StackPanel>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Blocks}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="card" Padding="10" Margin="0,0,0,8" Background="#252C3A">
                <StackPanel Spacing="6">
                  <StackPanel Classes="row">
                    <StackPanel><TextBlock Classes="label" Text="Label"/><TextBox Text="{Binding Label}" Width="150"/></StackPanel>
                    <StackPanel><TextBlock Classes="label" Text="RA"/><TextBox Text="{Binding Ra}" Width="110"/></StackPanel>
                    <StackPanel><TextBlock Classes="label" Text="Dec"/><TextBox Text="{Binding Dec}" Width="110"/></StackPanel>
                    <StackPanel><TextBlock Classes="label" Text="Epoch"/><ComboBox ItemsSource="{Binding Epochs}" SelectedItem="{Binding Epoch}" Width="90"/></StackPanel>
                  </StackPanel>
                  <StackPanel Classes="row">
                    <StackPanel><TextBlock Classes="label" Text="Seconds"/><NumericUpDown Value="{Binding Seconds}" Minimum="0" FormatString="0.##" Width="120"/></StackPanel>
                    <StackPanel><TextBlock Classes="label" Text="Count"/><NumericUpDown Value="{Binding Count}" Minimum="1" FormatString="0" Width="110"/></StackPanel>
                    <StackPanel><TextBlock Classes="label" Text="Filter"/><TextBox Text="{Binding Filter}" Width="100"/></StackPanel>
                    <StackPanel><TextBlock Classes="label" Text="Frame"/><ComboBox ItemsSource="{Binding FrameTypes}" SelectedItem="{Binding FrameType}" Width="90"/></StackPanel>
                    <CheckBox IsChecked="{Binding Refocus}" Content="Refocus before" VerticalAlignment="Bottom"/>
                    <Button Content="Remove" Command="{Binding $parent[UserControl].DataContext.RemoveBlockCommand}" CommandParameter="{Binding}" VerticalAlignment="Bottom"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="+ Add block" Command="{Binding AddBlockCommand}" HorizontalAlignment="Left"/>
        <StackPanel Classes="row">
          <Button Content="Start" Classes="primary" Command="{Binding StartPlanCommand}"/>
          <Button Content="Pause" Command="{Binding PauseCommand}"/>
          <Button Content="Resume" Command="{Binding ResumeCommand}"/>
          <Button Content="Abort" Classes="danger" Command="{Binding AbortCommand}"/>
        </StackPanel>
        <TextBlock Classes="error" Text="{Binding Message}" IsVisible="{Binding Message.Length}"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
