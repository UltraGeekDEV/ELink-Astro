<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="using:ELink.UI.Controls"
             x:Class="ELink.UI.Views.ProfilesView">
  <StackPanel Spacing="0">
    <Border Classes="card">
      <StackPanel>
        <TextBlock Classes="hint" Text="Skip this page if your INDI drivers are already running elsewhere. Otherwise: choose the drivers your equipment needs, save them as a profile and press Start. ELink runs them for you, connects the devices, and starts them again if they stop. (Advanced: the station can start a profile at launch with elink --profile NAME.)"/>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,6,0,0"/>
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Spacing="10">
        <WrapPanel Classes="row">
          <StackPanel><TextBlock Classes="label" Text="Profiles"/><ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" Width="220"/></StackPanel>
          <Button Content="Start" Classes="primary" Command="{Binding StartProfileCommand}" VerticalAlignment="Bottom"/>
          <Button Content="Stop" Command="{Binding StopProfileCommand}" VerticalAlignment="Bottom"/>
        </WrapPanel>
        <WrapPanel Classes="row">
          <StackPanel><TextBlock Classes="label" Text="Name"/><TextBox Text="{Binding Label}" Width="220" Watermark="Name this rig, e.g. Backyard"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Driver server port (advanced)"/><NumericUpDown Value="{Binding Port}" Minimum="1" Maximum="65535" FormatString="0" Width="130"/></StackPanel>
          <CheckBox IsChecked="{Binding AutoConnect}" Content="Connect the devices when started" VerticalAlignment="Bottom"/>
        </WrapPanel>
        <Grid ColumnDefinitions="*,16,300">
          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="Installed drivers (search: e.g. eqmod, asi, gphoto, focuser)"/>
            <TextBox Text="{Binding Search}" Watermark="search"/>
            <ListBox ItemsSource="{Binding Matches}" SelectedItem="{Binding SelectedMatch}" Height="240">
              <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Line}"/></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Button Content="Add →" Command="{Binding AddDriverCommand}"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="4">
            <TextBlock Classes="label" Text="In this profile"/>
            <ListBox ItemsSource="{Binding Chosen}" SelectedItem="{Binding SelectedChosen}" Height="270"/>
            <TextBlock Classes="hint" IsVisible="{Binding !Chosen.Count}" Text="Pick drivers on the left and press Add."/>
            <Button Content="Remove" Command="{Binding RemoveDriverCommand}"/>
          </StackPanel>
        </Grid>
        <WrapPanel Classes="row">
          <Button Content="Save profile" Classes="primary" Command="{Binding SaveCommand}"/>
          <Button Content="Delete profile" Classes="danger" Command="{Binding DeleteCommand}"/>
        </WrapPanel>
        <c:Notice Text="{Binding Message}" Kind="{Binding MessageKind}"/>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
