<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:ELink.UI.Controls"
             x:Class="ELink.UI.Views.RotatorPanelView">
  <StackPanel Spacing="0" IsEnabled="{Binding Connected}">
        <Border Classes="card">
      <WrapPanel Classes="row">
        <StackPanel><TextBlock Classes="label" Text="ANGLE"/><TextBlock Classes="value" Text="{Binding Angle, StringFormat={}{0:0.00}°}"/></StackPanel>
        <StackPanel Margin="24,0,0,0"><TextBlock Classes="label" Text="MOVING"/><TextBlock Classes="value" Text="{Binding Moving}"/></StackPanel>
      </WrapPanel>
    </Border>
    <Border Classes="card">
      <WrapPanel Classes="row">
        <StackPanel><TextBlock Classes="label" Text="Angle °"/><NumericUpDown Value="{Binding TargetAngle}" Minimum="-360" Maximum="720" FormatString="0.##" Width="160"/></StackPanel>
        <Button Content="Rotate" Classes="primary" Command="{Binding MoveToCommand}" VerticalAlignment="Bottom"/>
        <Button Content="Sync" Command="{Binding SyncCommand}" VerticalAlignment="Bottom"/>
        <Button Content="Abort" Classes="danger" Command="{Binding AbortCommand}" VerticalAlignment="Bottom"/>
      </WrapPanel>
    </Border>
    <c:Notice Text="{Binding Message}"/>
  </StackPanel>
</UserControl>
