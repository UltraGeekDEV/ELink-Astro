<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ELink.UI.Views.ComposerView">
  <StackPanel MaxWidth="940" Spacing="0">
    <Border Classes="card">
      <StackPanel Spacing="4">
        <TextBlock Classes="title" Text="Compose"/>
        <TextBlock TextWrapping="Wrap" Opacity="0.75"
                   Text="A smart scope is point-to plus shoot-at. Turn mounts into pointers and optics plus cameras into imaging trains, then combine pointers and trains (several per mount, other scopes too) into a scope that guides itself."/>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="section" Text="1 · POINTER FROM A MOUNT"/>
        <StackPanel Classes="row">
          <StackPanel><TextBlock Classes="label" Text="New pointer id"/><TextBox Text="{Binding NewPointerId}" Width="160" Watermark="e.g. eq6"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Mount"/><ComboBox ItemsSource="{Binding Mounts}" SelectedItem="{Binding SelectedMount}" Width="240"/></StackPanel>
          <Button Content="Define pointer" Command="{Binding DefinePointerCommand}" VerticalAlignment="Bottom"/>
        </StackPanel>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" IsVisible="{Binding PointerMessage}" Classes.error="{Binding MessageFailed}" Classes.ok="{Binding !MessageFailed}"/>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="section" Text="2 · IMAGING TRAIN"/>
        <TextBlock Classes="label" TextWrapping="Wrap" Text="One telescope or lens and what sits behind it. Give each camera its role: Imaging, or Guiding for an off-axis guider behind the same optics. A train with only a guide scope's camera can be another scope's guider."/>
        <StackPanel Classes="row">
          <StackPanel><TextBlock Classes="label" Text="Train id"/><TextBox Text="{Binding NewTrainId}" Width="140" Watermark="e.g. main"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Label"/><TextBox Text="{Binding TrainLabel}" Width="200" Watermark="e.g. 80/480 + ASI2600"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Focal length mm"/><NumericUpDown Value="{Binding FocalLength}" Minimum="0" Increment="10" FormatString="0.#" Width="140"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Aperture mm"/><NumericUpDown Value="{Binding Aperture}" Minimum="0" Increment="5" FormatString="0.#" Width="120"/></StackPanel>
        </StackPanel>
        <TextBlock Classes="label" TextWrapping="Wrap" Text="Cameras: role; for a DSLR its pixel size µm and sensor width × height px (0 = what the camera reports); gain and offset presets (empty = the camera's own); cooling set point °C and °C per minute (empty = no cooling: the train cools slowly once connected, the scope waits until cold)"/>
        <ItemsControl ItemsSource="{Binding TrainCameras}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Classes="row" Margin="0,0,0,2">
                <TextBlock Text="{Binding CameraId}" Width="200" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.CameraRoles}" SelectedItem="{Binding Role}" Width="130"/>
                <NumericUpDown Value="{Binding PixelSize}" Minimum="0" Increment="0.1" FormatString="0.##" Width="110" ShowButtonSpinner="False" ToolTip.Tip="pixel size µm, for DSLRs (0 = the camera's own)"/>
                <NumericUpDown Value="{Binding SensorWidth}" Minimum="0" FormatString="0" Width="100" ShowButtonSpinner="False" ToolTip.Tip="sensor width px (0 = the camera's own)"/>
                <NumericUpDown Value="{Binding SensorHeight}" Minimum="0" FormatString="0" Width="100" ShowButtonSpinner="False" ToolTip.Tip="sensor height px (0 = the camera's own)"/>
                <TextBox Text="{Binding Gain}" Width="70" Watermark="gain" ToolTip.Tip="gain preset (empty = the camera's own)"/>
                <TextBox Text="{Binding Offset}" Width="70" Watermark="offset" ToolTip.Tip="offset preset (empty = the camera's own)"/>
                <TextBox Text="{Binding CoolTo}" Width="70" Watermark="°C" ToolTip.Tip="cooling set point °C (empty = no cooling)"/>
                <NumericUpDown Value="{Binding CoolRate}" Minimum="0.1" Maximum="30" Increment="0.5" FormatString="0.#" Width="80" ShowButtonSpinner="False" ToolTip.Tip="cooling and warming °C per minute"/>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Classes="row">
          <StackPanel><TextBlock Classes="label" Text="Filter wheel"/><ComboBox ItemsSource="{Binding Wheels}" SelectedItem="{Binding SelectedWheel}" Width="180"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Focuser"/><ComboBox ItemsSource="{Binding Focusers}" SelectedItem="{Binding SelectedFocuser}" Width="180"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Rotator"/><ComboBox ItemsSource="{Binding Rotators}" SelectedItem="{Binding SelectedRotator}" Width="180"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Focus offsets (steps per filter)"/><TextBox Text="{Binding FocusOffsets}" Width="220" Watermark="L=0, R=30, Ha=120"/></StackPanel>
          <Button Content="Define train" Command="{Binding DefineTrainCommand}" VerticalAlignment="Bottom"/>
        </StackPanel>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" IsVisible="{Binding TrainMessage}" Classes.error="{Binding MessageFailed}" Classes.ok="{Binding !MessageFailed}"/>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="section" Text="3 · SMART SCOPE"/>
        <StackPanel Classes="row">
          <StackPanel><TextBlock Classes="label" Text="Scope id"/><TextBox Text="{Binding ScopeId}" Width="160" Watermark="e.g. wide"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Display name"/><TextBox Text="{Binding ScopeName}" Width="240"/></StackPanel>
        </StackPanel>
        <Grid ColumnDefinitions="*,16,*">
          <StackPanel>
            <TextBlock Classes="label" Text="Pointers (all are sent to the same target)"/>
            <TextBlock Text="define a pointer above" Classes="label" IsVisible="{Binding !PointerChoices.Count}"/>
            <ItemsControl ItemsSource="{Binding PointerChoices}">
              <ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}"/></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="label" Text="Trains (any number on one mount; offset of each from the pointing axis, arcmin)"/>
            <TextBlock Text="define a train above" Classes="label" IsVisible="{Binding !ShooterChoices.Count}"/>
            <ItemsControl ItemsSource="{Binding ShooterChoices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Classes="row">
                    <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}" MinWidth="200"/>
                    <NumericUpDown Value="{Binding EastArcmin}" Width="100" FormatString="0.#" ShowButtonSpinner="False" ToolTip.Tip="east offset, arcmin"/>
                    <NumericUpDown Value="{Binding NorthArcmin}" Width="100" FormatString="0.#" ShowButtonSpinner="False" ToolTip.Tip="north offset, arcmin"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
        <TextBlock Classes="label" Text="Guiding: the scope guides and dithers by itself with this (another train, a train's off-axis guider, or none)"/>
        <StackPanel Classes="row">
          <StackPanel><TextBlock Classes="label" Text="Guide with"/><ComboBox ItemsSource="{Binding GuideWith}" SelectedItem="{Binding SelectedGuideWith}" Width="190"/></StackPanel>
          <StackPanel IsVisible="{Binding Guided}"><TextBlock Classes="label" Text="Output"/><ComboBox ItemsSource="{Binding GuideOutputs}" SelectedItem="{Binding SelectedGuideOutput}" Width="130"/></StackPanel>
          <StackPanel IsVisible="{Binding Guided}"><StackPanel IsVisible="{Binding PulseOutput}"><TextBlock Classes="label" Text="Guide port"/><ComboBox ItemsSource="{Binding GuidePorts}" SelectedItem="{Binding SelectedGuidePort}" Width="180"/></StackPanel></StackPanel>
          <StackPanel IsVisible="{Binding Guided}"><StackPanel IsVisible="{Binding !PulseOutput}"><TextBlock Classes="label" Text="Target device id"/><TextBox Text="{Binding GuideTargetId}" Width="180"/></StackPanel></StackPanel>
          <StackPanel IsVisible="{Binding Guided}"><TextBlock Classes="label" Text="Guide exposure s"/><NumericUpDown Value="{Binding GuideExposure}" Minimum="0.05" Increment="0.5" FormatString="0.##" Width="130"/></StackPanel>
        </StackPanel>
        <StackPanel Classes="row" IsVisible="{Binding Guided}">
          <StackPanel><TextBlock Classes="label" Text="Dither every N rounds (0 = never)"/><NumericUpDown Value="{Binding DitherEvery}" Minimum="0" FormatString="0" Width="200"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Dither px"/><NumericUpDown Value="{Binding DitherPixels}" Minimum="0.5" Increment="1" FormatString="0.#" Width="110"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Settled below px"/><NumericUpDown Value="{Binding SettlePixels}" Minimum="0.1" Increment="0.5" FormatString="0.#" Width="130"/></StackPanel>
        </StackPanel>
        <StackPanel Classes="row">
          <CheckBox IsChecked="{Binding GradeFrames}" Content="Grade frames (reject clouds, trailing, soft, bright sky)" VerticalAlignment="Bottom"/>
          <CheckBox IsChecked="{Binding CenterAfterSlew}" Content="Centre after each slew (plate solve, re-aim)" VerticalAlignment="Bottom"/>
          <StackPanel><TextBlock Classes="label" Text="Within arcmin"/><NumericUpDown Value="{Binding CenterTolerance}" Minimum="0.05" Increment="0.25" FormatString="0.##" Width="120"/></StackPanel>
        </StackPanel>
        <TextBlock Classes="label" Text="Focus: every train with a focuser is refocused by the scope when one of these fires (0 = off)"/>
        <StackPanel Classes="row">
          <CheckBox IsChecked="{Binding FocusOnStart}" Content="At the start" VerticalAlignment="Bottom"/>
          <StackPanel><TextBlock Classes="label" Text="Every minutes"/><NumericUpDown Value="{Binding RefocusEveryMinutes}" Minimum="0" Increment="15" FormatString="0" Width="120"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Temperature moved °C"/><NumericUpDown Value="{Binding RefocusTemperature}" Minimum="0" Increment="0.5" FormatString="0.#" Width="150"/></StackPanel>
          <CheckBox IsChecked="{Binding RefocusOnFilter}" Content="On filter change" VerticalAlignment="Bottom"/>
          <StackPanel><TextBlock Classes="label" Text="Stars grew %"/><NumericUpDown Value="{Binding RefocusHfrPercent}" Minimum="0" Increment="5" FormatString="0" Width="120"/></StackPanel>
        </StackPanel>
        <StackPanel Classes="row">
          <CheckBox IsChecked="{Binding MeridianFlip}" Content="Flip by itself at the meridian (German mounts; needs the site)" VerticalAlignment="Bottom"/>
          <StackPanel><TextBlock Classes="label" Text="Flip this many minutes past the meridian"/><NumericUpDown Value="{Binding FlipAfterMinutes}" Minimum="0" Maximum="60" Increment="1" FormatString="0.#" Width="150"/></StackPanel>
        </StackPanel>
        <Button Content="Define scope" Classes="primary" Command="{Binding DefineScopeCommand}" HorizontalAlignment="Left"/>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" IsVisible="{Binding ScopeMessage}" Classes.error="{Binding MessageFailed}" Classes.ok="{Binding !MessageFailed}"/>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="8">
        <TextBlock Classes="section" Text="DEFINED"/>
        <StackPanel Classes="row">
          <ComboBox ItemsSource="{Binding Existing}" SelectedItem="{Binding SelectedExisting}" Width="300"/>
          <Button Content="Remove" Classes="danger" Command="{Binding RemoveCommand}"/>
        </StackPanel>
      </StackPanel>
    </Border>
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" IsVisible="{Binding OtherMessage}" Classes.error="{Binding MessageFailed}" Classes.ok="{Binding !MessageFailed}"/>
  </StackPanel>
</UserControl>
