<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ELink.UI.Views.ComposerView">
  <StackPanel MaxWidth="940" Spacing="0">
    <Border Classes="card">
      <StackPanel Spacing="4">
        <TextBlock Classes="title" Text="Compose"/>
        <TextBlock TextWrapping="Wrap" Opacity="0.75"
                   Text="A smart scope is point-to plus shoot-at. Turn mounts into pointers and cameras into shooters, then combine any pointers and shooters, including other scopes, into a scope."/>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="section" Text="1 · POINTER FROM A MOUNT"/>
        <StackPanel Classes="row">
          <StackPanel><TextBlock Classes="label" Text="New pointer id"/><TextBox Text="{Binding NewPointerId}" Width="160" Watermark="e.g. eq6"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Mount"/><ComboBox ItemsSource="{Binding Mounts}" SelectedItem="{Binding SelectedMount}" Width="240"/></StackPanel>
          <Button Content="Define pointer" Command="{Binding DefinePointerCommand}" VerticalAlignment="Bottom"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="section" Text="2 · SHOOTER FROM A CAMERA"/>
        <StackPanel Classes="row">
          <StackPanel><TextBlock Classes="label" Text="New shooter id"/><TextBox Text="{Binding NewShooterId}" Width="160" Watermark="e.g. main-cam"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Camera"/><ComboBox ItemsSource="{Binding Cameras}" SelectedItem="{Binding SelectedCamera}" Width="200"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Filter wheel (optional)"/><ComboBox ItemsSource="{Binding Wheels}" SelectedItem="{Binding SelectedWheel}" Width="200"/></StackPanel>
          <Button Content="Define shooter" Command="{Binding DefineShooterCommand}" VerticalAlignment="Bottom"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="section" Text="3 · GUIDER (OPTIONAL)"/>
        <TextBlock Classes="label" TextWrapping="Wrap" Text="A guide camera (a shooter, not one of the scope's imaging shooters) and where its corrections go: timed pulses to a guide port, or &quot;you are here, should be here&quot; to a device that moves itself. The scope that owns it guides and dithers on its own."/>
        <StackPanel Classes="row">
          <StackPanel><TextBlock Classes="label" Text="New guider id"/><TextBox Text="{Binding NewGuiderId}" Width="140" Watermark="e.g. guide"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Guide camera (shooter)"/><ComboBox ItemsSource="{Binding GuideCameras}" SelectedItem="{Binding SelectedGuideCamera}" Width="170"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Output"/><ComboBox ItemsSource="{Binding GuideOutputs}" SelectedItem="{Binding SelectedGuideOutput}" Width="130"/></StackPanel>
          <StackPanel IsVisible="{Binding PulseOutput}"><TextBlock Classes="label" Text="Guide port"/><ComboBox ItemsSource="{Binding GuidePorts}" SelectedItem="{Binding SelectedGuidePort}" Width="190"/></StackPanel>
          <StackPanel IsVisible="{Binding !PulseOutput}"><TextBlock Classes="label" Text="Target device id"/><TextBox Text="{Binding GuideTargetId}" Width="190"/></StackPanel>
        </StackPanel>
        <StackPanel Classes="row">
          <StackPanel><TextBlock Classes="label" Text="Mount it rides on"/><ComboBox ItemsSource="{Binding GuideMounts}" SelectedItem="{Binding SelectedGuideMount}" Width="190"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Exposure s"/><NumericUpDown Value="{Binding GuideExposure}" Minimum="0.05" Increment="0.5" FormatString="0.##" Width="120"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Pixel scale &quot;/px (0 = from FITS/solve)"/><NumericUpDown Value="{Binding GuideScale}" Minimum="0" Increment="0.1" FormatString="0.###" Width="170"/></StackPanel>
          <Button Content="Define guider" Command="{Binding DefineGuiderCommand}" VerticalAlignment="Bottom"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="10">
        <TextBlock Classes="section" Text="4 · SMART SCOPE"/>
        <StackPanel Classes="row">
          <StackPanel><TextBlock Classes="label" Text="Scope id"/><TextBox Text="{Binding ScopeId}" Width="160" Watermark="e.g. wide"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Display name"/><TextBox Text="{Binding ScopeName}" Width="240"/></StackPanel>
        </StackPanel>
        <Grid ColumnDefinitions="*,16,*">
          <StackPanel>
            <TextBlock Classes="label" Text="Pointers (all are sent to the same target)"/>
            <TextBlock Text="define a pointer above" Classes="label" IsVisible="{Binding !PointerChoices.Count}"/>
            <ItemsControl ItemsSource="{Binding PointerChoices}">
              <ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}"/></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Classes="label" Text="Shooters (offset of each from the pointing axis, arcmin)"/>
            <TextBlock Text="define a shooter above" Classes="label" IsVisible="{Binding !ShooterChoices.Count}"/>
            <ItemsControl ItemsSource="{Binding ShooterChoices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Classes="row">
                    <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Label}" MinWidth="200"/>
                    <NumericUpDown Value="{Binding EastArcmin}" Width="100" FormatString="0.#" ShowButtonSpinner="False" ToolTip.Tip="east offset, arcmin"/>
                    <NumericUpDown Value="{Binding NorthArcmin}" Width="100" FormatString="0.#" ShowButtonSpinner="False" ToolTip.Tip="north offset, arcmin"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
        <StackPanel Classes="row">
          <StackPanel><TextBlock Classes="label" Text="Its guider"/><ComboBox ItemsSource="{Binding Guiders}" SelectedItem="{Binding SelectedGuider}" Width="170"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Dither every N rounds (0 = never)"/><NumericUpDown Value="{Binding DitherEvery}" Minimum="0" FormatString="0" Width="200"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Dither px"/><NumericUpDown Value="{Binding DitherPixels}" Minimum="0.5" Increment="1" FormatString="0.#" Width="110"/></StackPanel>
          <StackPanel><TextBlock Classes="label" Text="Settled below px"/><NumericUpDown Value="{Binding SettlePixels}" Minimum="0.1" Increment="0.5" FormatString="0.#" Width="130"/></StackPanel>
        </StackPanel>
        <Button Content="Define scope" Classes="primary" Command="{Binding DefineScopeCommand}" HorizontalAlignment="Left"/>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="8">
        <TextBlock Classes="section" Text="DEFINED"/>
        <StackPanel Classes="row">
          <ComboBox ItemsSource="{Binding Existing}" SelectedItem="{Binding SelectedExisting}" Width="300"/>
          <Button Content="Remove" Classes="danger" Command="{Binding RemoveCommand}"/>
        </StackPanel>
      </StackPanel>
    </Border>
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" IsVisible="{Binding Message.Length}"/>
  </StackPanel>
</UserControl>
