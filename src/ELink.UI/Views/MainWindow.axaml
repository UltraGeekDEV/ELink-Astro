<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ELink.UI.ViewModels"
        xmlns:v="using:ELink.UI.Views"
        xmlns:i="using:ELink.UI.Infrastructure"
        xmlns:c="using:ELink.UI.Controls"
        x:Class="ELink.UI.Views.MainWindow"
        Title="ELink" Background="#0F131A" Width="1280" Height="820" MinWidth="960" MinHeight="620">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+D1" Command="{Binding GoSkyCommand}"/>
    <KeyBinding Gesture="Ctrl+D2" Command="{Binding GoScopesCommand}"/>
    <KeyBinding Gesture="Ctrl+D3" Command="{Binding GoRigCommand}"/>
    <KeyBinding Gesture="Ctrl+D4" Command="{Binding GoAdvancedCommand}"/>
    <KeyBinding Gesture="Escape" Command="{Binding CloseDrawerCommand}"/>
  </Window.KeyBindings>
  <Grid RowDefinitions="Auto,Auto,*">
    <!-- joining a mesh: only when the UI runs on its own -->
    <Border Grid.Row="0" Background="#171C27" Padding="14,8" IsVisible="{Binding ShowConnectionBar}" BorderBrush="#2B3548" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Classes="row" VerticalAlignment="Center">
          <TextBlock Classes="label" Text="ELink station at" VerticalAlignment="Center"/>
          <TextBox Text="{Binding Host}" Width="140" Watermark="host"/>
          <NumericUpDown Value="{Binding Port}" Minimum="1" Maximum="65535" FormatString="0" Width="100"/>
          <Button Content="Connect" Classes.primary="{Binding !Mesh.IsConnected}" Command="{Binding ConnectCommand}"/>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding ConnectionStatus}" VerticalAlignment="Center" Classes="label"/>
      </Grid>
    </Border>

    <v:StatusBarView Grid.Row="1" DataContext="{Binding StatusBar}"/>

    <Grid Grid.Row="2" ColumnDefinitions="176,*">
      <Border Classes="panel" Padding="10,14" BorderBrush="#2B3548" BorderThickness="0,0,1,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="ELink" Classes="title" Margin="12,0,0,18"/>
          <TextBlock DockPanel.Dock="Bottom" Classes="hint" Text="{Binding ConnectionStatus}" Margin="12,0" IsVisible="{Binding !ShowConnectionBar}"/>
          <StackPanel Spacing="4">
            <Button Classes="nav" Classes.active="{Binding IsSky}" Command="{Binding GoSkyCommand}" Content="Sky" ToolTip.Tip="Pick a target, frame the image, watch it build  (Ctrl+1)"/>
            <Button Classes="nav" Classes.active="{Binding IsScopes}" Command="{Binding GoScopesCommand}" Content="Scopes" ToolTip.Tip="What each scope is doing  (Ctrl+2)"/>
            <Button Classes="nav" Classes.active="{Binding IsRig}" Command="{Binding GoRigCommand}" Content="Rig" ToolTip.Tip="Set up and look after your equipment  (Ctrl+3)"/>
            <Button Classes="nav" Classes.active="{Binding IsAdvanced}" Command="{Binding GoAdvancedCommand}" Content="Advanced" ToolTip.Tip="Raw INDI properties, saving frames, manual tools  (Ctrl+4)"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <ContentControl Grid.Column="1" Content="{Binding Current}"/>

      <!-- dims the page behind a device panel: click it to close the panel -->
      <Button Grid.Column="1" IsVisible="{Binding HasDrawer}" Command="{Binding CloseDrawerCommand}" Background="#99070A10" BorderThickness="0" CornerRadius="0"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ToolTip.Tip="Close the device panel"/>

      <!-- one device's own panel, over the right edge -->
      <Border Grid.Column="1" HorizontalAlignment="Right" Width="470" Background="#131822" BorderBrush="#2B3548" BorderThickness="1,0,0,0"
              IsVisible="{Binding HasDrawer}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="16,12,10,6">
            <StackPanel>
              <TextBlock Text="{Binding Drawer.Title}" Classes="title"/>
              <TextBlock Text="{Binding Drawer.Kind}" Classes="hint"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Classes="row" VerticalAlignment="Top" Spacing="4">
              <Button Content="{Binding Drawer.ConnectButtonText}" Command="{Binding Drawer.ConnectCommand}"/>
              <Button Content="✕" Classes="ghost" Command="{Binding CloseDrawerCommand}" ToolTip.Tip="Close"/>
            </StackPanel>
          </Grid>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,6,16,16" Spacing="10">
              <c:Notice Kind="warn" Text="{Binding Drawer.ConnectionHint}"/>
              <ContentControl Content="{Binding Drawer}"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- toasts -->
      <ItemsControl Grid.Column="1" ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,16" Width="380">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="#222B3C" BorderBrush="#3A4660" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,6,0,0">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Classes.error="{Binding Css, Converter={x:Static i:Chips.IsError}}"/>
                <Button Grid.Column="1" Content="✕" Classes="ghost" Padding="6,0" Command="{Binding $parent[Window].DataContext.DismissToastCommand}" CommandParameter="{Binding}" VerticalAlignment="Top"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </Grid>
</Window>
